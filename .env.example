# Copy to .env in the Mewmo root. Never reuse rental-mgmt credentials.
# Use a URL-safe random password (e.g. openssl rand -hex 32).
DB_PASSWORD=replace-with-a-unique-random-password
# Used only when the account migration creates the initial administrator.
# Generate with scripts/hash_password.py. Keep single quotes around dollar signs.
# Existing installs may keep OWNER_PASSWORD_HASH instead for this migration.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='replace-with-generated-scrypt-hash'
PUBLIC_WEB_URL=https://mewmo.example.com
COOKIE_SECURE=true
CORS_ORIGINS=https://mewmo.example.com,capacitor://localhost
MEWMO_HTTP_PORT=8092
# Optional AI settings: generate once with Fernet.generate_key(); see README.
# Keep this secret stable and back it up separately from the database.
LLM_ENCRYPTION_KEY=
# Uncomment to run Mewmo's own HTTPS edge. See "TLS and Sharing a Server" in the README.
# COMPOSE_FILE=compose.yaml:deploy/compose.edge.yaml
# MEWMO_HTTPS_PORT=9443

# Optional until push setup. Keep keys in ./secrets, readable by UID 10001.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.jpi.mewmo
APNS_SANDBOX=false
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
